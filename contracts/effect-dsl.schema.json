{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optcg.dev/contracts/effect-dsl.schema.json",
  "title": "OPTCG Effect DSL Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["cardId", "implementationStatus", "effects", "metadata"],
  "properties": {
    "cardId": {
      "type": "string",
      "minLength": 1
    },
    "implementationStatus": {
      "$ref": "#/$defs/cardSupportStatus"
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effectBlock"
      }
    },
    "metadata": {
      "$ref": "#/$defs/effectDefinitionMetadata"
    }
  },
  "$defs": {
    "attribute": {
      "type": "string",
      "enum": ["slash", "strike", "ranged", "special", "wisdom", "?"]
    },
    "cardCategory": {
      "type": "string",
      "enum": ["leader", "character", "event", "stage", "don"]
    },
    "cardFilter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cardIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "names": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "nameContains": {
          "type": "string",
          "minLength": 1
        },
        "nameNot": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "categories": {
          "type": "array",
          "items": { "$ref": "#/$defs/cardCategory" }
        },
        "colorsAny": {
          "type": "array",
          "items": { "$ref": "#/$defs/color" }
        },
        "colorsAll": {
          "type": "array",
          "items": { "$ref": "#/$defs/color" }
        },
        "typesAny": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "typesAll": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "attributesAny": {
          "type": "array",
          "items": { "$ref": "#/$defs/attribute" }
        },
        "attributesAll": {
          "type": "array",
          "items": { "$ref": "#/$defs/attribute" }
        },
        "cost": {
          "$ref": "#/$defs/numericFilter"
        },
        "power": {
          "$ref": "#/$defs/numericFilter"
        },
        "counter": {
          "$ref": "#/$defs/numericFilter"
        },
        "hasKeywords": {
          "type": "array",
          "items": { "$ref": "#/$defs/keyword" }
        },
        "lacksKeywords": {
          "type": "array",
          "items": { "$ref": "#/$defs/keyword" }
        },
        "state": {
          "type": "string",
          "enum": ["active", "rested", "attached"]
        },
        "owner": {
          "$ref": "#/$defs/playerRef"
        },
        "controller": {
          "$ref": "#/$defs/playerRef"
        },
        "excludeSelf": {
          "type": "boolean"
        },
        "custom": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "leaderMetadataCardFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories"],
      "properties": {
        "categories": {
          "type": "array",
          "prefixItems": [{ "const": "leader" }],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "typesAny": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "attributesAny": {
          "type": "array",
          "items": { "$ref": "#/$defs/attribute" },
          "minItems": 1
        }
      },
      "anyOf": [
        {
          "required": ["typesAny"],
          "properties": { "typesAny": true }
        },
        {
          "required": ["attributesAny"],
          "properties": { "attributesAny": true }
        }
      ]
    },
    "scopedSetBasePowerFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typesAny"],
      "properties": {
        "typesAny": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "scopedSetBasePowerTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "zone", "player"],
      "properties": {
        "type": { "const": "all" },
        "zone": { "const": "characterArea" },
        "player": { "const": "self" },
        "filter": { "$ref": "#/$defs/scopedSetBasePowerFilter" }
      }
    },
    "scopedTopNSearchPublicFilter": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "categories": {
          "type": "array",
          "items": { "$ref": "#/$defs/cardCategory" },
          "minItems": 1
        },
        "colorsAny": {
          "type": "array",
          "items": { "$ref": "#/$defs/color" },
          "minItems": 1
        },
        "typesAny": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "nameNot": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "scopedTopNSearchChooserOnlyFilter": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "scopedStartOfGameStageSearchFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories", "typesAny"],
      "properties": {
        "categories": {
          "type": "array",
          "prefixItems": [{ "const": "stage" }],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "typesAny": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "scopedTopNSearchRemainingCards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "position", "order"],
      "properties": {
        "destination": { "const": "deck" },
        "position": { "const": "bottom" },
        "order": { "const": "ownerChoice" }
      }
    },
    "scopedTopNSearchRequest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zone",
            "player",
            "lookCount",
            "filter",
            "min",
            "max",
            "destination",
            "revealTo",
            "remainingCards",
            "shuffleAfter"
          ],
          "properties": {
            "zone": { "const": "deck" },
            "player": { "const": "self" },
            "lookCount": { "type": "integer", "minimum": 1 },
            "filter": { "$ref": "#/$defs/scopedTopNSearchPublicFilter" },
            "min": { "const": 0 },
            "max": { "const": 1 },
            "destination": { "const": "hand" },
            "revealTo": { "const": "bothPlayers" },
            "remainingCards": {
              "$ref": "#/$defs/scopedTopNSearchRemainingCards"
            },
            "shuffleAfter": { "const": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zone",
            "player",
            "lookCount",
            "filter",
            "min",
            "max",
            "destination",
            "revealTo",
            "remainingCards",
            "shuffleAfter"
          ],
          "properties": {
            "zone": { "const": "deck" },
            "player": { "const": "self" },
            "lookCount": { "type": "integer", "minimum": 1 },
            "filter": { "$ref": "#/$defs/scopedTopNSearchChooserOnlyFilter" },
            "min": { "const": 0 },
            "max": { "const": 1 },
            "destination": { "const": "hand" },
            "revealTo": { "const": "chooserOnly" },
            "remainingCards": {
              "$ref": "#/$defs/scopedTopNSearchRemainingCards"
            },
            "shuffleAfter": { "const": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zone",
            "player",
            "filter",
            "min",
            "max",
            "destination",
            "revealTo",
            "shuffleAfter"
          ],
          "properties": {
            "zone": { "const": "deck" },
            "player": { "const": "self" },
            "filter": { "$ref": "#/$defs/scopedStartOfGameStageSearchFilter" },
            "min": { "const": 0 },
            "max": { "const": 1 },
            "destination": { "const": "stageArea" },
            "revealTo": { "const": "chooserOnly" },
            "shuffleAfter": { "const": false }
          }
        }
      ]
    },
    "scopedOptionalFieldTrashCostFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories", "typesAny"],
      "properties": {
        "categories": {
          "type": "array",
          "prefixItems": [{ "const": "character" }],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "typesAny": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "scopedOptionalChooseOneTrashCostAlternative": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "count", "chooser", "optional"],
          "properties": {
            "type": { "const": "trashFromHand" },
            "count": { "type": "integer", "minimum": 1 },
            "filter": { "$ref": "#/$defs/cardFilter" },
            "chooser": { "$ref": "#/$defs/playerRef" },
            "optional": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "count", "chooser", "filter", "optional"],
          "properties": {
            "type": { "const": "trashFromField" },
            "count": { "type": "integer", "minimum": 1 },
            "chooser": { "const": "self" },
            "filter": { "$ref": "#/$defs/scopedOptionalFieldTrashCostFilter" },
            "optional": { "const": true }
          }
        }
      ]
    },
    "cardSupportStatus": {
      "type": "string",
      "enum": [
        "vanilla-confirmed",
        "implemented-dsl",
        "implemented-custom",
        "unsupported",
        "banned-in-simulator"
      ]
    },
    "color": {
      "type": "string",
      "enum": ["red", "green", "blue", "purple", "black", "yellow"]
    },
    "comparator": {
      "type": "string",
      "enum": ["eq", "neq", "gt", "gte", "lt", "lte"]
    },
    "cost": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "count"],
          "properties": {
            "type": { "const": "restDon" },
            "count": { "type": "integer", "minimum": 0 },
            "chooser": { "$ref": "#/$defs/playerRef" },
            "optional": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "count"],
          "properties": {
            "type": { "const": "returnDon" },
            "count": { "type": "integer", "minimum": 0 },
            "chooser": { "$ref": "#/$defs/playerRef" },
            "optional": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "restSelf" },
            "optional": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "costs"],
          "properties": {
            "type": { "const": "sequence" },
            "costs": {
              "type": "array",
              "items": { "$ref": "#/$defs/cost" },
              "minItems": 1
            },
            "optional": { "type": "boolean" }
          }
        }
      ]
    },
    "optionalCost": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "count", "optional"],
          "properties": {
            "type": { "const": "restDon" },
            "count": { "type": "integer", "minimum": 0 },
            "chooser": { "$ref": "#/$defs/playerRef" },
            "optional": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "count", "optional"],
          "properties": {
            "type": { "const": "returnDon" },
            "count": { "type": "integer", "minimum": 0 },
            "chooser": { "$ref": "#/$defs/playerRef" },
            "optional": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "optional"],
          "properties": {
            "type": { "const": "restSelf" },
            "optional": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "count", "chooser", "optional"],
          "properties": {
            "type": { "const": "trashFromHand" },
            "count": { "type": "integer", "minimum": 1 },
            "filter": { "$ref": "#/$defs/cardFilter" },
            "chooser": { "$ref": "#/$defs/playerRef" },
            "optional": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "costs", "optional"],
          "properties": {
            "type": { "const": "sequence" },
            "costs": {
              "type": "array",
              "items": { "$ref": "#/$defs/cost" },
              "minItems": 1
            },
            "optional": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "options", "optional"],
          "properties": {
            "type": { "const": "chooseOne" },
            "options": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/scopedOptionalChooseOneTrashCostAlternative"
              },
              "minItems": 1
            },
            "optional": { "const": true }
          }
        }
      ]
    },
    "duration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "thisAction",
                "thisBattle",
                "thisTurn",
                "whileSourceOnField",
                "permanent"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "untilEndOfTurn" },
            "whoseTurn": {
              "type": "string",
              "enum": ["current", "sourceController", "targetController"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "player"],
          "properties": {
            "type": { "const": "untilStartOfNextTurn" },
            "player": { "$ref": "#/$defs/playerRef" }
          }
        }
      ]
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "count", "player"],
          "properties": {
            "type": { "const": "draw" },
            "count": { "type": "integer", "minimum": 0 },
            "player": { "$ref": "#/$defs/playerRef" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "request"],
          "properties": {
            "type": { "const": "search" },
            "request": { "$ref": "#/$defs/scopedTopNSearchRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "count", "player"],
          "properties": {
            "type": { "const": "drawUpTo" },
            "count": { "type": "integer", "minimum": 0 },
            "player": { "$ref": "#/$defs/playerRef" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "player", "chooser", "count"],
          "properties": {
            "type": { "const": "trashFromHand" },
            "player": { "$ref": "#/$defs/playerRef" },
            "chooser": { "$ref": "#/$defs/playerRef" },
            "count": { "type": "integer", "minimum": 0 },
            "filter": { "$ref": "#/$defs/cardFilter" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "zone",
            "player",
            "chooser",
            "min",
            "max",
            "filter",
            "saveAs",
            "visibility"
          ],
          "properties": {
            "type": { "const": "selectCards" },
            "zone": { "const": "hand" },
            "player": { "const": "self" },
            "chooser": { "const": "self" },
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 },
            "filter": { "$ref": "#/$defs/cardFilter" },
            "saveAs": { "$ref": "#/$defs/handSelectionId" },
            "visibility": { "const": "chooserOnly" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "selection"],
          "properties": {
            "type": { "const": "playSelected" },
            "selection": {
              "anyOf": [
                { "$ref": "#/$defs/handSelectionId" },
                { "const": "selected:start-of-game" }
              ]
            },
            "enterRested": { "type": "boolean" },
            "ignoreCost": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "request"],
          "properties": {
            "type": { "const": "selectTargets" },
            "request": { "$ref": "#/$defs/selectedTargetsRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target"],
          "properties": {
            "type": { "const": "ko" },
            "target": { "$ref": "#/$defs/target" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target", "value", "duration"],
          "properties": {
            "type": { "const": "modifyPower" },
            "target": { "$ref": "#/$defs/target" },
            "value": { "type": "integer" },
            "duration": { "$ref": "#/$defs/duration" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target", "value", "duration"],
          "properties": {
            "type": { "const": "setBasePower" },
            "target": { "$ref": "#/$defs/scopedSetBasePowerTarget" },
            "value": { "type": "integer" },
            "duration": { "const": { "type": "permanent" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target", "duration"],
          "properties": {
            "type": { "const": "cannotAttack" },
            "target": { "$ref": "#/$defs/target" },
            "duration": { "$ref": "#/$defs/duration" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target", "duration"],
          "properties": {
            "type": { "const": "cannotBlock" },
            "target": { "$ref": "#/$defs/target" },
            "duration": { "$ref": "#/$defs/duration" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target", "keyword", "duration"],
          "properties": {
            "type": { "const": "giveKeyword" },
            "target": { "$ref": "#/$defs/target" },
            "keyword": { "$ref": "#/$defs/keyword" },
            "duration": { "$ref": "#/$defs/duration" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target", "protection", "duration"],
          "properties": {
            "type": { "const": "giveProtection" },
            "target": { "$ref": "#/$defs/target" },
            "protection": { "$ref": "#/$defs/effectDslFieldRemovalProtection" },
            "duration": { "$ref": "#/$defs/duration" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "effects"],
          "properties": {
            "type": { "const": "sequence" },
            "effects": {
              "type": "array",
              "items": { "$ref": "#/$defs/sequencedEffect" },
              "minItems": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "effects": {
                    "type": "array",
                    "contains": {
                      "type": "object",
                      "required": ["effect"],
                      "properties": {
                        "effect": {
                          "type": "object",
                          "required": ["type"],
                          "properties": {
                            "type": { "const": "playSelected" }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "effects": {
                    "type": "array",
                    "contains": {
                      "type": "object",
                      "required": ["effect"],
                      "properties": {
                        "effect": {
                          "anyOf": [
                            {
                              "type": "object",
                              "required": ["type"],
                              "properties": {
                                "type": { "const": "selectCards" }
                              }
                            },
                            {
                              "type": "object",
                              "required": ["type", "request"],
                              "properties": {
                                "type": { "const": "search" },
                                "request": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "zone",
                                    "player",
                                    "filter",
                                    "min",
                                    "max",
                                    "destination",
                                    "revealTo",
                                    "shuffleAfter"
                                  ],
                                  "properties": {
                                    "zone": { "const": "deck" },
                                    "player": { "const": "self" },
                                    "filter": {
                                      "$ref": "#/$defs/scopedStartOfGameStageSearchFilter"
                                    },
                                    "min": { "const": 0 },
                                    "max": { "const": 1 },
                                    "destination": { "const": "stageArea" },
                                    "revealTo": { "const": "chooserOnly" },
                                    "shuffleAfter": { "const": false }
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "effects": {
                    "type": "array",
                    "contains": {
                      "type": "object",
                      "required": ["effect"],
                      "properties": {
                        "effect": {
                          "type": "object",
                          "required": ["target"],
                          "properties": {
                            "target": {
                              "type": "object",
                              "required": ["type", "binding"],
                              "properties": {
                                "type": { "const": "savedFieldObject" },
                                "binding": {
                                  "type": "object",
                                  "required": ["family"],
                                  "properties": {
                                    "family": { "const": "selectedTargets" }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "effects": {
                    "type": "array",
                    "contains": {
                      "type": "object",
                      "required": ["effect", "saveResultAs"],
                      "properties": {
                        "saveResultAs": {
                          "type": "string",
                          "minLength": 1
                        },
                        "effect": {
                          "type": "object",
                          "required": ["type"],
                          "properties": {
                            "type": { "const": "selectTargets" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "handler"],
          "properties": {
            "type": { "const": "custom" },
            "handler": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "payCostEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "cost"],
      "properties": {
        "type": { "const": "payCost" },
        "cost": { "$ref": "#/$defs/optionalCost" }
      }
    },
    "effectBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "trigger", "effect"],
      "allOf": [
        {
          "not": {
            "properties": {
              "effect": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": { "const": "playSelected" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": { "const": "replacement" }
            },
            "required": ["category"]
          },
          "then": {
            "properties": {
              "effect": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": { "const": "replacement" }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": ["auto", "activate", "permanent", "replacement"]
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "conditionTiming": {
          "type": "string",
          "enum": ["activation", "resolution", "both"]
        },
        "cost": {
          "$ref": "#/$defs/cost"
        },
        "optional": {
          "type": "boolean"
        },
        "oncePerTurn": {
          "type": "boolean"
        },
        "failurePolicy": {
          "type": "string",
          "enum": [
            "doAsMuchAsPossible",
            "requiresAll",
            "skipIfNoLegalTarget",
            "optionalIfPossible"
          ]
        },
        "sourcePresencePolicy": {
          "type": "string",
          "enum": [
            "mustRemainInSameZone",
            "resolveFromDestinationZone",
            "resolveFromLastKnownInformation",
            "noSourceRequired"
          ]
        },
        "effect": {
          "$ref": "#/$defs/effect"
        }
      }
    },
    "effectDefinitionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceTextHash",
        "rulesVersion",
        "effectDefinitionsVersion",
        "tested"
      ],
      "properties": {
        "sourceTextHash": {
          "type": "string",
          "minLength": 1
        },
        "rulesVersion": {
          "type": "string",
          "minLength": 1
        },
        "effectDefinitionsVersion": {
          "type": "string",
          "minLength": 1
        },
        "tested": {
          "type": "boolean"
        },
        "reviewer": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "generatedBy": {
          "type": "string",
          "enum": ["manual", "rule-parser", "llm-assisted"]
        },
        "reviewedBy": {
          "type": "string"
        },
        "reviewedAt": {
          "type": "string"
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "yourTurn" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target", "op", "value"],
          "properties": {
            "type": { "const": "attachedDonCount" },
            "target": { "$ref": "#/$defs/target" },
            "op": { "$ref": "#/$defs/comparator" },
            "value": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "player", "op", "value"],
          "properties": {
            "type": { "const": "lifeCount" },
            "player": { "$ref": "#/$defs/playerRef" },
            "op": { "$ref": "#/$defs/comparator" },
            "value": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "player", "op", "value"],
          "allOf": [
            {
              "if": {
                "properties": {
                  "filter": {
                    "type": "object",
                    "properties": {
                      "categories": {
                        "type": "array",
                        "contains": { "const": "don" }
                      }
                    },
                    "required": ["categories"]
                  }
                },
                "required": ["filter"]
              },
              "then": {
                "properties": {
                  "player": {
                    "type": "string",
                    "enum": ["self", "opponent"]
                  },
                  "filter": {
                    "type": "object",
                    "properties": {
                      "custom": false
                    }
                  }
                }
              }
            }
          ],
          "properties": {
            "type": { "const": "fieldCount" },
            "player": { "$ref": "#/$defs/playerRef" },
            "filter": { "$ref": "#/$defs/cardFilter" },
            "op": { "$ref": "#/$defs/comparator" },
            "value": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "player", "op", "value"],
          "properties": {
            "type": { "const": "handCount" },
            "player": { "$ref": "#/$defs/playerRef" },
            "op": { "$ref": "#/$defs/comparator" },
            "value": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "player", "op", "value"],
          "properties": {
            "type": { "const": "trashCount" },
            "player": { "$ref": "#/$defs/playerRef" },
            "filter": { "$ref": "#/$defs/cardFilter" },
            "op": { "$ref": "#/$defs/comparator" },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "player", "op", "value"],
          "properties": {
            "type": { "const": "leaderColorCount" },
            "player": { "$ref": "#/$defs/playerRef" },
            "op": { "$ref": "#/$defs/comparator" },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "zone", "player", "filter"],
          "properties": {
            "type": { "const": "hasCardInZone" },
            "zone": { "const": "leaderArea" },
            "player": { "$ref": "#/$defs/playerRef" },
            "filter": { "$ref": "#/$defs/leaderMetadataCardFilter" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target", "state"],
          "properties": {
            "type": { "const": "cardState" },
            "target": { "$ref": "#/$defs/target" },
            "state": { "type": "string", "enum": ["active", "rested"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "sourceStillInZone" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "conditions"],
          "properties": {
            "type": { "const": "and" },
            "conditions": {
              "type": "array",
              "items": { "$ref": "#/$defs/condition" },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "conditions"],
          "properties": {
            "type": { "const": "or" },
            "conditions": {
              "type": "array",
              "items": { "$ref": "#/$defs/condition" },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "condition"],
          "properties": {
            "type": { "const": "not" },
            "condition": { "$ref": "#/$defs/condition" }
          }
        }
      ]
    },
    "keyword": {
      "type": "string",
      "enum": [
        "rush",
        "rushCharacter",
        "doubleAttack",
        "banish",
        "blocker",
        "unblockable"
      ]
    },
    "handSelectionId": {
      "type": "string",
      "pattern": "^handSelection:[A-Za-z0-9][A-Za-z0-9:_-]*$"
    },
    "numericFilter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "value"],
          "properties": {
            "op": { "$ref": "#/$defs/comparator" },
            "value": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "protectionExclusionPolicy": {
      "type": "string",
      "enum": ["excluded", "failClosed"]
    },
    "protectionFieldRemovalClassification": {
      "type": "string",
      "enum": [
        "moveFromFieldToTrash",
        "moveFromFieldToHand",
        "moveFromFieldToDeck",
        "moveFromFieldToLife",
        "moveFromFieldToOtherZone"
      ]
    },
    "protectionFieldRemovalExclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "battleKO",
        "ruleProcessTrash",
        "controllerCost",
        "controllerOwnedEffect",
        "ambiguousCustomRemoval"
      ],
      "properties": {
        "battleKO": { "$ref": "#/$defs/protectionExclusionPolicy" },
        "ruleProcessTrash": { "$ref": "#/$defs/protectionExclusionPolicy" },
        "controllerCost": { "$ref": "#/$defs/protectionExclusionPolicy" },
        "controllerOwnedEffect": {
          "$ref": "#/$defs/protectionExclusionPolicy"
        },
        "ambiguousCustomRemoval": {
          "$ref": "#/$defs/protectionExclusionPolicy"
        }
      }
    },
    "protectionFieldRemovalMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processFamily",
        "classification",
        "sourceKind",
        "sourceControllerRelation",
        "targetScope",
        "exclusions"
      ],
      "properties": {
        "processFamily": { "const": "fieldRemoval" },
        "classification": {
          "$ref": "#/$defs/protectionFieldRemovalClassification"
        },
        "sourceKind": {
          "type": "string",
          "enum": ["cardEffect", "ruleProcess", "battle", "cost", "custom"]
        },
        "sourceControllerRelation": {
          "type": "string",
          "enum": [
            "opponentControlled",
            "selfControlled",
            "eitherController",
            "unknownController"
          ]
        },
        "targetScope": {
          "type": "string",
          "enum": [
            "thisCard",
            "controllerFieldCharacter",
            "controllerField",
            "anyFieldCard"
          ]
        },
        "exclusions": { "$ref": "#/$defs/protectionFieldRemovalExclusions" }
      }
    },
    "effectDslFieldRemovalProtection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process", "fieldRemoval"],
      "properties": {
        "process": { "const": "fieldRemoval" },
        "fieldRemoval": {
          "$ref": "#/$defs/protectionFieldRemovalMetadata"
        }
      }
    },
    "playerRef": {
      "type": "string",
      "enum": [
        "self",
        "opponent",
        "turnPlayer",
        "nonTurnPlayer",
        "owner",
        "controller"
      ]
    },
    "sequencedEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "connector"],
      "allOf": [
        {
          "if": {
            "properties": {
              "effect": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": { "const": "payCost" }
                }
              }
            }
          },
          "then": {
            "not": {
              "properties": {
                "optional": {}
              },
              "required": ["optional"]
            }
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "$ref": "#/$defs/sequencedEffectEffect"
        },
        "connector": {
          "type": "string",
          "enum": [
            "always",
            "then",
            "ifPreviousSucceeded",
            "ifYouDo",
            "ifPossible"
          ]
        },
        "saveResultAs": {
          "type": "string",
          "minLength": 1
        },
        "optional": {
          "type": "boolean"
        }
      }
    },
    "sequencedEffectEffect": {
      "oneOf": [
        { "$ref": "#/$defs/effect" },
        { "$ref": "#/$defs/payCostEffect" }
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "self",
                "myLeader",
                "opponentLeader",
                "attacker",
                "attackTarget",
                "blocker",
                "triggerCard"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "zone", "player"],
          "properties": {
            "type": { "const": "all" },
            "zone": { "$ref": "#/$defs/zone" },
            "player": { "$ref": "#/$defs/playerRef" },
            "filter": { "$ref": "#/$defs/cardFilter" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "request"],
          "properties": {
            "type": { "const": "choose" },
            "request": { "$ref": "#/$defs/targetRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "binding",
            "zone",
            "player",
            "visibility",
            "onFailure"
          ],
          "properties": {
            "type": { "const": "savedFieldObject" },
            "binding": { "$ref": "#/$defs/savedFieldObjectTargetBinding" },
            "zone": { "$ref": "#/$defs/savedFieldObjectZone" },
            "player": { "$ref": "#/$defs/playerRef" },
            "controller": { "$ref": "#/$defs/playerRef" },
            "filter": { "$ref": "#/$defs/cardFilter" },
            "visibility": { "const": "publicOnly" },
            "onFailure": { "const": "failClosed" }
          }
        }
      ]
    },
    "savedFieldObjectTargetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "saveResultAs"],
      "properties": {
        "family": {
          "type": "string",
          "enum": ["selectedTargets", "producedObjects"]
        },
        "saveResultAs": {
          "type": "string",
          "minLength": 1
        },
        "objectIndex": {
          "type": "integer",
          "minimum": 0
        },
        "sourceSegmentId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "savedFieldObjectZone": {
      "type": "string",
      "enum": ["leaderArea", "characterArea", "stageArea", "costArea"]
    },
    "selectedTargetsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timing",
        "chooser",
        "zone",
        "player",
        "min",
        "max",
        "allowFewerIfUnavailable",
        "visibility"
      ],
      "properties": {
        "timing": {
          "type": "string",
          "enum": ["onActivation", "onResolution"]
        },
        "chooser": {
          "$ref": "#/$defs/playerRef"
        },
        "zone": {
          "$ref": "#/$defs/savedFieldObjectZone"
        },
        "player": {
          "$ref": "#/$defs/playerRef"
        },
        "filter": {
          "$ref": "#/$defs/cardFilter"
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "allowFewerIfUnavailable": {
          "type": "boolean"
        },
        "visibility": {
          "const": "public"
        }
      }
    },
    "targetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timing",
        "chooser",
        "zone",
        "player",
        "min",
        "max",
        "allowFewerIfUnavailable"
      ],
      "properties": {
        "timing": {
          "type": "string",
          "enum": ["onActivation", "onResolution"]
        },
        "chooser": {
          "$ref": "#/$defs/playerRef"
        },
        "zone": {
          "$ref": "#/$defs/zone"
        },
        "player": {
          "$ref": "#/$defs/playerRef"
        },
        "filter": {
          "$ref": "#/$defs/cardFilter"
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "allowFewerIfUnavailable": {
          "type": "boolean"
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "privateToChooser"]
        }
      }
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "onPlay",
                "whenAttacking",
                "onOpponentAttack",
                "onBlock",
                "onKO",
                "endOfYourTurn",
                "endOfOpponentTurn",
                "trigger",
                "activateMain",
                "main",
                "counter",
                "permanent",
                "startOfGame",
                "startOfYourTurn",
                "startOfOpponentTurn",
                "startOfMainPhase",
                "endOfBattle"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "count"],
          "properties": {
            "type": { "const": "donAttach" },
            "count": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "event"],
          "properties": {
            "type": { "const": "custom" },
            "event": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "zone": {
      "type": "string",
      "enum": [
        "hand",
        "deck",
        "trash",
        "life",
        "costArea",
        "characterArea",
        "stageArea",
        "leaderArea",
        "donDeck",
        "noZone"
      ]
    }
  }
}
