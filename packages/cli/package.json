{
  "name": "@optcg/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "boot:summary": "node --no-warnings --experimental-strip-types --loader ./scripts/source-loader.mjs src/cli.ts --boot-summary",
    "typecheck": "corepack pnpm exec tsc -p tsconfig.json --noEmit",
    "test": "corepack pnpm exec vitest run --root ../.. packages/cli/src"
  },
  "dependencies": {
    "@optcg/engine-core": "workspace:*",
    "@optcg/types": "workspace:*"
  }
}
