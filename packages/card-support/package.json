{
  "name": "@optcg/card-support",
  "version": "0.1.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "support:probe": "node --no-warnings --experimental-strip-types --loader ./scripts/source-loader.mjs src/support-probe.ts",
    "behavior:probe": "node --no-warnings --experimental-strip-types --loader ./scripts/source-loader.mjs src/behavior-probe-cli.ts",
    "behavior:coverage": "node --no-warnings --experimental-strip-types --loader ./scripts/source-loader.mjs src/behavior-coverage-cli.ts",
    "spotlight:probe": "node --no-warnings --experimental-strip-types --loader ./scripts/source-loader.mjs src/spotlight-probe.ts",
    "master:probe": "node --no-warnings --experimental-strip-types --loader ./scripts/source-loader.mjs src/master-probe-cli.ts",
    "typecheck": "corepack pnpm exec tsc -p tsconfig.json --noEmit",
    "test": "corepack pnpm exec vitest run --root ../.. packages/card-support/src",
    "prepublishOnly": "corepack pnpm exec tsc -p tsconfig.json"
  },
  "dependencies": {
    "@optcg/cards": "workspace:*",
    "@optcg/engine-core": "workspace:*",
    "@optcg/types": "workspace:*",
    "optcg-deck-hash": "^0.1.4"
  }
}
