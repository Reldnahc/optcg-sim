{
  "name": "@optcg/match-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "start": "corepack pnpm exec tsx src/server.ts",
    "dev": "corepack pnpm run start",
    "typecheck": "corepack pnpm exec tsc -p tsconfig.json --noEmit",
    "test": "corepack pnpm exec vitest run --root ../.. packages/match-server/src"
  },
  "dependencies": {
    "@optcg/card-support": "workspace:*",
    "@optcg/cards": "workspace:*",
    "@optcg/engine-core": "workspace:*",
    "@optcg/types": "workspace:*",
    "optcg-card-cache": "0.1.2",
    "optcg-db": "^0.4.40",
    "optcg-deck-hash": "^0.1.4",
    "redis": "5.12.1"
  }
}
