{
  "name": "@optcg/cards",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "capture:fixture": "node --no-warnings --experimental-strip-types --loader ./scripts/source-loader.mjs src/fixture-capture.ts",
    "support:probe": "corepack pnpm exec tsx src/support-probe.ts",
    "typecheck": "corepack pnpm exec tsc -p tsconfig.json --noEmit",
    "test": "corepack pnpm exec vitest run --root ../.. packages/cards/src"
  },
  "dependencies": {
    "@optcg/types": "workspace:*",
    "ajv": "^8.20.0",
    "zod": "^4.4.3"
  }
}
